# Database (PostgreSQL - use Neon or Supabase for free managed Postgres)
DATABASE_URL="postgresql://user:password@host:5432/careerverse?sslmode=require"

# NextAuth v5
AUTH_SECRET="your-32-char-secret-here-generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com)
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# GitHub OAuth (https://github.com/settings/developers)
AUTH_GITHUB_ID="your-github-client-id"
AUTH_GITHUB_SECRET="your-github-client-secret"

# Groq API - FREE forever (https://console.groq.com)
GROQ_API_KEY="gsk_..."

# File Storage - Vercel Blob or Cloudinary
BLOB_READ_WRITE_TOKEN="vercel_blob_..."
# OR Cloudinary:
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email (Resend for magic links)
AUTH_RESEND_KEY="re_..."
EMAIL_FROM="noreply@careerverse.ai"
